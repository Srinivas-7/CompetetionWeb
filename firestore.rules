rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // GANAPATHI TRAIL 2026 - CLIENT-AUTHENTICATED SECURITY RULES
    // 
    // - NO service account keys required.
    // - Uses cryptographic Firebase Google Auth (request.auth.uid).
    // - Guarantees exactly 1 vote per authenticated Google user.
    // =========================================================================

    // 1. Live Aggregate Counter & Shards
    match /counters/{counterId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /shards/{shardId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // 2. Voter Ballot Lock (Strictly 1 vote per request.auth.uid)
    match /voters/{voterDocId} {
      // User can read their own voter record
      allow read: if request.auth != null;
      
      // User can create their ballot ONLY ONCE if the document ID matches their UID
      allow create: if request.auth != null 
                    && (voterDocId == "ganapathi_chaturthi_2026_" + request.auth.uid || voterDocId == request.auth.uid)
                    && request.resource.data.uid == request.auth.uid;
                    
      // Disallow tampering or changing the ballot after creation
      allow update, delete: if false;
    }

    match /votes/{voteDocId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && voteDocId == request.auth.uid;
      allow update, delete: if false;
    }

    // Default lockdown for any other collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
