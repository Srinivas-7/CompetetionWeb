rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // GANAPATHI TRAIL 2026 - PRODUCTION SECURITY RULES
    //
    // ALL voting writes and counter increments are mediated exclusively 
    // through the Vercel serverless API (/api/vote) using the Firebase Admin SDK.
    // 
    // The Firebase Admin SDK bypasses these rules entirely on the server.
    // Direct client SDK browser connections are strictly locked down to 
    // prevent vote tampering, counter spoofing, or bot manipulation.
    // =========================================================================

    // 1. Lockdown all collections by default
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Lock down /voters/ collection (Admin SDK only)
    match /voters/{voterId} {
      allow read, write: if false;
    }

    // 3. Lock down /votes/ collection (Admin SDK only)
    match /votes/{voteId} {
      allow read, write: if false;
    }

    // 4. Lock down /counters/ and all shards (Admin SDK only)
    match /counters/{counterId} {
      allow read, write: if false;

      match /shards/{shardId} {
        allow read, write: if false;
      }
    }
  }
}
