rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // GANAPATHI TRAIL 2026 - PRODUCTION SECURITY RULES
    // 
    // - Public live leaderboard counter reads (authenticated and guest)
    // - Authenticated Google Identity (request.auth.uid) for voting
    // - 1 vote per UID per event with distributed + top-level counter synchronization
    // =========================================================================

    // 1. Top-Level Counters (21 Pandhals)
    match /counters/{pandhalId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. Sharded Counters (21 Pandhals × 10 Shards = 210 Shards)
    match /{path=**}/shards/{shardId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /counters/{pandhalId}/shards/{shardId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. Voter Ballot Records
    match /voters/{voterDocId} {
      // Allow voters to read their ballot status (and public aggregate verification)
      allow read: if true;
      
      // Allow authenticated user to write their ballot
      allow write: if request.auth != null;
    }

    // 4. Default collection access
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
