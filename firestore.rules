rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // GANAPATHI TRAIL 2026 - PRODUCTION SECURITY RULES
    // 
    // - Authenticated users (request.auth != null) can cast 1 vote for their UID
    // - Voters cannot update or delete their vote document once created
    // - Distributed counters and shards are publicly readable and writeable by voters
    // =========================================================================

    // 1. Sharded Counters & Top-Level Counters
    match /counters/{pandhalId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /counters/{pandhalId}/shards/{shardId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{path=**}/shards/{shardId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. Voter Ballot Records (1 vote per authenticated user UID)
    match /voters/{voterDocId} {
      // Allow users to read only their own ballot document
      allow read: if request.auth != null && voterDocId == ('ganapathi_chaturthi_2026_' + request.auth.uid);
      
      // Allow authenticated users to create only their own unique vote doc (cannot update or delete)
      allow create: if request.auth != null 
                    && voterDocId == ('ganapathi_chaturthi_2026_' + request.auth.uid)
                    && request.time >= timestamp.value(1789475400000);
      allow update, delete: if false;
    }

    // 3. Default fallback
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
