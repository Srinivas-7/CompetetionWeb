rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // GANAPATHI TRAIL 2026 - PRODUCTION SECURITY RULES
    //
    // READS:
    // - Counter shards are publicly readable for real-time live vote counts.
    // - Authenticated users can read their own voter record to verify ballot state.
    //
    // WRITES:
    // - Direct client writes are 100% DISABLED across all collections.
    // - All ballot submissions and shard increments are processed atomically
    //   through the serverless Admin SDK (/api/vote).
    // =========================================================================

    // 1. Sharded Counters & Aggregates (Public Read, Server-Only Write)
    match /counters/{pandhalId} {
      allow read: if true;
      allow write: if false;

      match /shards/{shardId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // 2. Voter Records (Authenticated User Read, Server-Only Write)
    match /voters/{voterDocId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /votes/{voteDocId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Default lockdown for any other path
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
