rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // GANAPATHI TRAIL 2026 - PRODUCTION SECURITY RULES
    // 
    // - All writes MUST go through backend Firebase Admin API (/api/vote)
    // - NO direct browser writes allowed to ANY collection (voters, counters, shards)
    // - Authenticated users can read only their own ballot record
    // - Shards and counters are publicly readable or queried via /api/counters
    // =========================================================================

    // 1. Sharded Counters & Top-Level Counters (Read-only, writes forbidden from browser)
    match /counters/{pandhalId} {
      allow read: if true;
      allow write: if false;
    }

    match /counters/{pandhalId}/shards/{shardId} {
      allow read: if true;
      allow write: if false;
    }

    match /{path=**}/shards/{shardId} {
      allow read: if true;
      allow write: if false;
    }

    // 2. Voter Ballot Records
    match /voters/{voterDocId} {
      // Allow users to read only their own ballot document
      allow read: if request.auth != null && voterDocId == ('ganapathi_chaturthi_2026_' + request.auth.uid);
      
      // Absolutely NO direct browser writes (must go through /api/vote with verifyIdToken)
      allow write: if false;
    }

    // 3. Default fallback: deny all writes
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}

