# ==============================================================================
# FIREBASE CLIENT-SIDE CONFIGURATION (Safe to expose in client bundle - VITE_ prefix)
# Obtain these from: Firebase Console -> Project Settings -> General -> Your Apps -> Web App
# ==============================================================================
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="1:your-messaging-sender-id:web:your-app-id"

# Firebase App Check (reCAPTCHA v3 Site Key)
# Obtain from: Firebase Console -> App Check -> Apps -> Register Web App -> reCAPTCHA v3
VITE_FIREBASE_RECAPTCHA_SITE_KEY="your-recaptcha-v3-site-key"


# ==============================================================================
# FIREBASE SERVER-SIDE ADMIN CONFIGURATION (SERVER-ONLY - NEVER expose to client!)
# Obtain from: Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
# ==============================================================================
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"

# NOTE on FIREBASE_PRIVATE_KEY:
# In .env.local: Wrap the private key in double quotes with literal \n (e.g., "-----BEGIN PRIVATE KEY-----\nMIIEvgI...\n-----END PRIVATE KEY-----\n")
# In Vercel Dashboard: Paste the exact multi-line private key directly into the value field (or with \n escaped).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
